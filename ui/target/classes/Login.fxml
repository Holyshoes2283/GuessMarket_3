<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!--
    Login Screen View
    Controller: com.guessmarket.ui.LoginController
-->
<VBox alignment="CENTER" spacing="20.0" prefHeight="300.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.guessmarket.ui.LoginController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <Label text="Welcome to GuessMarket">
        <font>
            <Font name="System Bold" size="20.0" />
        </font>
    </Label>

    <Label text="Please enter your unique username to connect:" textAlignment="CENTER" wrapText="true"/>

    <TextField fx:id="usernameField" promptText="e.g., alon" prefHeight="35.0" onAction="#handleLogin"/>

    <Label fx:id="errorLabel" textFill="#d32f2f" wrapText="true">
        <font>
            <Font size="12.0" />
        </font>
    </Label>

    <Button fx:id="loginButton" mnemonicParsing="false" onAction="#handleLogin" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #1976D2; -fx-text-fill: white;" text="Connect">
        <font>
            <Font name="System Bold" size="14.0" />
        </font>
    </Button>
</VBox>