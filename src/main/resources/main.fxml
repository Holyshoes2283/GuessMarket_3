<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!--
    Root Layout: BorderPane
    Controller: com.guessmarket.ui.MainController

    Phase 22 Layout Refactoring:
    - Implemented strictly two-tab split: Events and Account.
    - Switched to generic JavaFX XML namespaces to resolve IDE schema inspection errors.
    - Zero-Trust Client Policy: Added lblSessionUser to globally reflect the active authenticated session.
    - Added Session Teardown (Logout) capability.
-->
<BorderPane prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.guessmarket.ui.MainController">

    <!-- TOP REGION: GLOBAL ACTIONS & SESSION INFO -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <Button fx:id="loadXmlButton" mnemonicParsing="false" onAction="#handleLoadFile" prefHeight="35.0" prefWidth="130.0" text="Load XML File">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Button>
            <Label fx:id="filePathLabel" style="-fx-text-fill: #757575;" text="No file loaded..." />

            <!-- Spacer to push the session label to the far right -->
            <Region HBox.hgrow="ALWAYS" />

            <!-- Persistent Session Indicator (Zero-Trust UI Architecture) -->
            <Label fx:id="lblSessionUser" text="Logged in as: Unknown" style="-fx-font-weight: bold; -fx-text-fill: #1976D2; -fx-font-size: 15px;" />

            <!-- Session Teardown / Logout Button -->
            <Button mnemonicParsing="false" onAction="#handleLogout" style="-fx-background-color: #D32F2F; -fx-text-fill: white;" text="Log Out">
                <font>
                    <Font name="System Bold" size="12.0" />
                </font>
            </Button>
        </HBox>
    </top>

    <!-- CENTER REGION: TABBED INTERFACE -->
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">

            <!-- TAB 1: EVENTS -->
            <Tab text="Events">
                <BorderPane>
                    <top>
                        <HBox alignment="CENTER_LEFT" spacing="15.0" BorderPane.alignment="CENTER">
                            <padding>
                                <Insets bottom="10.0" left="15.0" right="15.0" top="15.0" />
                            </padding>
                            <Label text="Filters:">
                                <font>
                                    <Font name="System Bold" size="14.0" />
                                </font>
                            </Label>
                            <ComboBox fx:id="filterEventMethodComboBox" prefWidth="180.0" promptText="By event method" />
                            <ComboBox fx:id="filterStatusComboBox" prefWidth="180.0" promptText="By status" />
                            <ComboBox fx:id="filterCommissionComboBox" prefWidth="200.0" promptText="By commission method" />
                        </HBox>
                    </top>

                    <center>
                        <SplitPane dividerPositions="0.45" BorderPane.alignment="CENTER">
                            <!-- Left: Events Table -->
                            <VBox spacing="10.0">
                                <padding>
                                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                </padding>
                                <Label text="Guess Market Events">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                </Label>
                                <ScrollPane fitToHeight="true" fitToWidth="true" VBox.vgrow="ALWAYS">
                                    <TableView fx:id="eventsTableView">
                                        <columns>
                                            <TableColumn fx:id="colEventId" prefWidth="60.0" text="ID" />
                                            <TableColumn fx:id="colEventName" prefWidth="180.0" text="Event Title" />
                                            <TableColumn fx:id="colEventStatus" prefWidth="100.0" text="Status" />
                                            <TableColumn fx:id="colMarketMaker" prefWidth="120.0" text="Market Maker" />
                                        </columns>
                                        <columnResizePolicy>
                                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                        </columnResizePolicy>
                                    </TableView>
                                </ScrollPane>
                            </VBox>

                            <!-- Right: Order Books & Participation Records -->
                            <VBox spacing="10.0">
                                <padding>
                                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                </padding>
                                <Label fx:id="lblOption1OB" text="Option 1 OB Statistics">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <ScrollPane fitToHeight="true" fitToWidth="true" VBox.vgrow="ALWAYS">
                                    <TableView fx:id="option1OrderBookTableView">
                                        <columns>
                                            <TableColumn fx:id="opt1BidCol" prefWidth="60.0" text="BID" />
                                            <TableColumn fx:id="opt1AskCol" prefWidth="60.0" text="ASK" />
                                            <TableColumn fx:id="opt1LastCol" prefWidth="60.0" text="LAST" />
                                            <TableColumn fx:id="opt1MidCol" prefWidth="60.0" text="MID" />
                                            <TableColumn fx:id="opt1SpreadCol" prefWidth="60.0" text="SPREAD" />
                                        </columns>
                                        <columnResizePolicy>
                                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                        </columnResizePolicy>
                                    </TableView>
                                </ScrollPane>

                                <Label fx:id="lblOption2OB" text="Option 2 OB Statistics">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <ScrollPane fitToHeight="true" fitToWidth="true" VBox.vgrow="ALWAYS">
                                    <TableView fx:id="option2OrderBookTableView">
                                        <columns>
                                            <TableColumn fx:id="opt2BidCol" prefWidth="60.0" text="BID" />
                                            <TableColumn fx:id="opt2AskCol" prefWidth="60.0" text="ASK" />
                                            <TableColumn fx:id="opt2LastCol" prefWidth="60.0" text="LAST" />
                                            <TableColumn fx:id="opt2MidCol" prefWidth="60.0" text="MID" />
                                            <TableColumn fx:id="opt2SpreadCol" prefWidth="60.0" text="SPREAD" />
                                        </columns>
                                        <columnResizePolicy>
                                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                        </columnResizePolicy>
                                    </TableView>
                                </ScrollPane>

                                <Label text="Participation Information">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <ScrollPane fitToHeight="true" fitToWidth="true" VBox.vgrow="ALWAYS">
                                    <TableView fx:id="participationsInfoTableView">
                                        <columns>
                                            <TableColumn prefWidth="150.0" text="User" />
                                            <TableColumn prefWidth="150.0" text="Option" />
                                        </columns>
                                        <columnResizePolicy>
                                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                        </columnResizePolicy>
                                    </TableView>
                                </ScrollPane>
                            </VBox>
                        </SplitPane>
                    </center>
                </BorderPane>
            </Tab>

            <!-- TAB 2: ACCOUNT -->
            <Tab text="Account">
                <SplitPane dividerPositions="0.45">
                    <!-- Left: Account & Market Directory -->
                    <VBox spacing="10.0">
                        <padding>
                            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                        </padding>
                        <Label text="Market Participants">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <ScrollPane fitToHeight="true" fitToWidth="true" VBox.vgrow="ALWAYS">
                            <TableView fx:id="usersTableView">
                                <columns>
                                    <TableColumn fx:id="colUserName" prefWidth="200.0" text="Username" />
                                    <TableColumn fx:id="colUserBalance" prefWidth="100.0" text="Balance" />
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>
                        </ScrollPane>
                    </VBox>

                    <!-- Right: Execution Panel -->
                    <VBox spacing="10.0">
                        <padding>
                            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                        </padding>

                        <Label text="My Account Overview">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <VBox.margin>
                                <Insets bottom="10.0" top="5.0" />
                            </VBox.margin>
                            <Label text="Account Balance:">
                                <font>
                                    <Font name="System Bold" size="14.0" />
                                </font>
                            </Label>
                            <Label fx:id="accountBalanceLabel" style="-fx-text-fill: #2e7d32;" text="\$0.00">
                                <font>
                                    <Font name="System Bold" size="15.0" />
                                </font>
                            </Label>
                        </HBox>

                        <VBox fx:id="singleEventTradePanel" disable="true" spacing="15.0" style="-fx-background-color: #f9f9f9; -fx-border-color: #dddddd; -fx-border-radius: 5; -fx-background-radius: 5;">
                            <padding>
                                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                            </padding>
                            <VBox.margin>
                                <Insets bottom="10.0" />
                            </VBox.margin>

                            <Label text="Execution and Orders">
                                <font>
                                    <Font name="System Bold" size="16.0" />
                                </font>
                            </Label>

                            <GridPane hgap="10.0" vgap="10.0">
                                <Label text="Active User:" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <font><Font name="System Bold" size="12.0" /></font>
                                </Label>
                                <Label fx:id="lblActiveUser" text="None" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                                <Label text="Target Event:" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <font><Font name="System Bold" size="12.0" /></font>
                                </Label>
                                <Label fx:id="lblActiveEvent" text="None" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            </GridPane>

                            <TableView fx:id="outcomesTableView" minHeight="120.0" prefHeight="120.0" VBox.vgrow="NEVER">
                                <columns>
                                    <TableColumn fx:id="colOutcomeDesc" prefWidth="150.0" text="Outcome"/>
                                    <TableColumn fx:id="colOutcomePrice" prefWidth="100.0" text="Current Price"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>

                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <TextField fx:id="txtSharesAmount" prefHeight="35.0" prefWidth="150.0" promptText="Amount of shares" />
                                <Button fx:id="btnExecuteTrade" mnemonicParsing="false" onAction="#handleTradeExecution" prefHeight="35.0" prefWidth="160.0" style="-fx-background-color: #2e7d32; -fx-text-fill: white;" text="Submit Market Order">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Button>
                            </HBox>

                            <HBox fx:id="mmControlsBox" alignment="CENTER_LEFT" managed="false" spacing="10.0" visible="false">
                                <VBox.margin>
                                    <Insets top="5.0" />
                                </VBox.margin>
                                <Button fx:id="btnStartEvent" mnemonicParsing="false" onAction="#handleStartEvent" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #1976D2; -fx-text-fill: white;" text="Start Event">
                                    <font><Font name="System Bold" size="12.0" /></font>
                                </Button>
                                <Button fx:id="btnCloseEvent" mnemonicParsing="false" onAction="#handleCloseEvent" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #D32F2F; -fx-text-fill: white;" text="Close Event">
                                    <font><Font name="System Bold" size="12.0" /></font>
                                </Button>
                            </HBox>
                        </VBox>

                        <Label text="Events Participation">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <ScrollPane fitToHeight="true" fitToWidth="true" VBox.vgrow="ALWAYS">
                            <TableView fx:id="eventsParticipationTableView">
                                <columns>
                                    <TableColumn fx:id="colParticipationEventName" prefWidth="200.0" text="Event Name" />
                                    <TableColumn prefWidth="100.0" text="Status" />
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>
                        </ScrollPane>
                    </VBox>
                </SplitPane>
            </Tab>

        </TabPane>
    </center>
</BorderPane>